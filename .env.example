# Mike Fitness Tracker - environment variables (EXAMPLE - safe to commit).
#
# Copy this file to ".env" (or ".env.local") and fill in the two Supabase
# values from: Supabase dashboard -> Project Settings -> API.
#
# Leave the Supabase values blank to keep the app in LOCAL MODE
# (localStorage only). The app works fully offline without Supabase.
#
# IMPORTANT: only the public "anon" key belongs in the frontend.
# NEVER put the service_role key in this file or anywhere in the frontend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_NAME=Mike Fitness Tracker
VITE_APP_ENV=production
